filters:
  and:
    - type == "person"
views:
  - type: table
    name: All
    order:
      - file.name
      - relationship
      - org
      - email
    sort:
      - property: file.name
        direction: ASC
  - type: table
    name: Colleagues
    filters:
      and:
        - relationship == "colleague"
    order:
      - file.name
      - org
      - email
    sort:
      - property: file.name
        direction: ASC
  - type: table
    name: Friends
    filters:
      and:
        - relationship == "friend"
    order:
      - file.name
      - relationship
      - birthday
    sort:
      - property: file.name
        direction: ASC
  - type: table
    name: Family
    filters:
      and:
        - relationship == "family"
    order:
      - file.name
      - birthday
    sort:
      - property: file.name
        direction: ASC
